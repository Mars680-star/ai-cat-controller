AI_CAT_HARDWARE_DRIVER=mock
AI_CAT_API_HOST=127.0.0.1
AI_CAT_API_PORT=8000
AI_CAT_LOG_LEVEL=INFO

AI_CAT_API_KEY_ENABLED=false
AI_CAT_API_KEY=

AI_CAT_COMMAND_TIMEOUT_SECONDS=12.0
AI_CAT_DIALOG_START_TIMEOUT_SECONDS=30.0
AI_CAT_MOTION_COOLDOWN_SECONDS=0.2
# Use k1_vendor_smooth only on a device validated against docs/k1-motion-profiles.md.
AI_CAT_MOTION_PROFILE=legacy_safe
AI_CAT_ENABLE_TAIL_MOTION=false
AI_CAT_DEBUG_UNLOCK_ALL_ACTIONS=false
AI_CAT_DEBUG_UNLIMITED_TOUCH_INTIMACY=false
# Mock always allows growth simulation. Local K1 requires this explicit switch.
AI_CAT_ENABLE_DEBUG_GROWTH=false
# Destructive browser reset; keep false unless explicitly needed for testing.
AI_CAT_ENABLE_PRODUCT_DATA_RESET=false
AI_CAT_ENABLE_TOUCH_MOTION=true
AI_CAT_TOUCH_MOTION_COOLDOWN_SECONDS=3.0
AI_CAT_ENABLE_TOUCH_SPEECH=false
AI_CAT_TOUCH_SPEECH_COOLDOWN_SECONDS=3.0
AI_CAT_TOUCH_SPEECH_ASSET_ROOT=/opt/ai-cat-controller/assets/local-speech
AI_CAT_TOUCH_SPEECH_MARKER_PATH=/run/ai-cat/local-speech-active
AI_CAT_TOUCH_SPEECH_PLAYER_PATH=/usr/bin/paplay
AI_CAT_AUTONOMY_INITIAL_DELAY_SECONDS=45
AI_CAT_AUTONOMY_MIN_INTERVAL_SECONDS=180
AI_CAT_AUTONOMY_MAX_INTERVAL_SECONDS=180
AI_CAT_AUTONOMY_PHRASE_PROBABILITY=1.0
AI_CAT_AUTONOMY_CLOUD_SPEECH_ENABLED=false
AI_CAT_AUTONOMY_LOCAL_SPEECH_ENABLED=true
AI_CAT_AUTONOMY_LOCAL_SPEECH_ASSET_ROOT=/opt/ai-cat-controller/assets/local-speech
AI_CAT_AUTONOMY_LOCAL_SPEECH_MARKER_PATH=/run/ai-cat/local-speech-active
AI_CAT_AUTONOMY_LOCAL_SPEECH_PLAYER_PATH=/usr/bin/paplay
AI_CAT_AUTONOMY_LOCAL_SPEECH_MOTION_SETTLE_SECONDS=2.2
AI_CAT_CONVERSATION_MOTION_ENABLED=true
AI_CAT_CONVERSATION_MOTION_PROBABILITY=1.0
AI_CAT_CONVERSATION_MOTION_DELAY_SECONDS=1.0
AI_CAT_CONVERSATION_POLL_INTERVAL_SECONDS=0.5
AI_CAT_SERVICE_STATUS_CACHE_SECONDS=2.0
AI_CAT_DATA_PATH=.data/ai-cat-mock.db
AI_CAT_INTIMACY_DAILY_CAP=50

AI_CAT_HARDWARE_BINARY=/usr/bin/ai-toy_app
AI_CAT_SYSTEMCTL_BINARY=/usr/bin/systemctl
AI_CAT_PULSEAUDIO_CTL_BINARY=/usr/bin/pactl
AI_CAT_PULSE_SERVER=unix:/var/run/pulse/native
AI_CAT_TOUCH_EVENT_LOG_PATH=/root/.log/main_log
AI_CAT_TOUCH_MONITOR_POLL_SECONDS=0.5
# Left and right physical paws require this many touches within the time window.
AI_CAT_PAW_TOUCH_CONFIRMATION_COUNT=2
AI_CAT_PAW_TOUCH_CONFIRMATION_WINDOW_SECONDS=3.0
AI_CAT_DIALOG_STATUS_PATH=/run/ai-cat/dialog-status.json
AI_CAT_DIALOG_EVENT_PATH=/var/lib/ai-cat-controller/dialog-events.jsonl
AI_CAT_DIALOG_TEXT_REQUEST_PATH=/var/lib/ai-cat-controller/dialog-text-request.json
AI_CAT_PERSONALITY_RUNTIME_PATH=/var/lib/ai-cat-controller/personality-runtime.json
AI_CAT_DIALOG_CONFIG_PATH=.data/dialog-runtime-config.json
AI_CAT_DEVICE_SERIAL_PATH=/proc/device-tree/serial-number
AI_CAT_BATTERY_SUPPLY_PATH=/sys/class/power_supply/cw-bat
AI_CAT_CHARGER_SUPPLY_PATH=/sys/class/power_supply/ip2317-charger
AI_CAT_DIALOG_SERVICE=volc-conv-ai.service
AI_CAT_WAKE_SERVICE=volc-k1-wake-word.service
AI_CAT_PULSEAUDIO_SERVICE=volc-pulseaudio.service
