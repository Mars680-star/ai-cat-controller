<view class="disclosure"><button class="trigger" bindtap="toggle" aria-expanded="{{open}}" aria-label="{{open ? '收起' : '展开'}}{{title}}"><view><text class="title">{{title}}</text><text class="count">{{countText || count + ' 条'}}</text></view><image class="chevron {{open ? 'open' : ''}}" src="/assets/icons/chevron-right.png" /></button><view wx:if="{{open}}" class="content"><slot /></view></view>
