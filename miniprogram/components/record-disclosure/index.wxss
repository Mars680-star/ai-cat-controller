.disclosure { overflow: hidden; border: 1rpx solid var(--color-line); border-radius: var(--radius-card); background: var(--color-surface); box-shadow: var(--shadow-card); }
.trigger { display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; gap: var(--space-4); width: 100%; max-width: 100%; min-width: 0; min-height: 100rpx; margin: 0; padding: var(--space-4) var(--space-6); border: 0; text-align: left; line-height: 1.5; background: transparent; }
.trigger::after { border: 0; }
.title { color: var(--color-title); font-size: 27rpx; font-weight: 650; }
.count { margin-left: var(--space-2); color: var(--color-muted); font-size: 22rpx; }
.chevron { width: 32rpx; height: 32rpx; transition: transform .2s ease; }
.chevron.open { transform: rotate(90deg); }
.content { border-top: 1rpx solid var(--color-line); }
