:host { display: block; min-width: 0; }
.live-panel { box-sizing: border-box; width: 100%; min-width: 0; padding: 26rpx; border: 1rpx solid var(--color-line, #e4e7e1); border-radius: 18rpx; background: var(--color-surface, #fff); }
.panel-heading, .section-heading, .device-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; min-width: 0; }
.heading-copy { flex: 1; min-width: 0; }
.eyebrow { display: block; margin-bottom: 10rpx; color: var(--color-primary-deep, #8a651d); font-size: 21rpx; font-weight: 700; }
.panel-title { display: block; color: var(--color-title, #222620); font-size: 34rpx; font-weight: 750; overflow-wrap: anywhere; }
.mode-pill { flex-shrink: 0; padding: 10rpx 12rpx; border-radius: 9rpx; color: var(--color-primary-deep, #8a651d); background: var(--color-primary-soft, #fff4cc); font-size: 21rpx; }
.panel-copy, .boundary-copy, .small-copy, .empty-copy { display: block; margin-top: 18rpx; color: var(--color-muted, #798278); font-size: 24rpx; line-height: 1.7; overflow-wrap: anywhere; }
.boundary-copy, .small-copy { font-size: 21rpx; }
.connection-label { display: block; margin-top: 10rpx; color: var(--color-muted, #798278); font-size: 24rpx; font-weight: 650; }
.connection-label.online, .device-badge.online { color: var(--color-success, #2d7d5e); }
.panel-button, .text-button, .pet-button { display: flex; align-items: center; justify-content: center; box-sizing: border-box; max-width: 100%; min-width: 0; min-height: 88rpx; margin: 22rpx 0 0; padding: 16rpx; border: 0; border-radius: 12rpx; font-size: 25rpx; font-weight: 650; line-height: 1.5; }
.panel-button { width: 100%; color: var(--color-title, #222620); background: var(--color-primary, #e7be44); }
.panel-button.secondary { background: var(--color-surface-soft, #f6f6f3); }
.panel-button::after, .text-button::after, .pet-button::after { border: 0; }
.panel-button[disabled], .text-button[disabled], .pet-button[disabled] { color: var(--color-muted, #798278); background: var(--color-surface-soft, #f6f6f3); opacity: .65; }
.text-button { flex-shrink: 0; width: auto; margin: 0; padding: 14rpx 18rpx; color: var(--color-primary-deep, #8a651d); background: transparent; font-size: 23rpx; }
.preview-button { width: 100%; margin-top: 18rpx; font-weight: 400; }
.error-block { margin-top: 20rpx; padding: 20rpx; border: 1rpx solid var(--color-danger-border, #e3cbc5); border-radius: 12rpx; color: var(--color-danger, #a75a49); font-size: 24rpx; line-height: 1.6; overflow-wrap: anywhere; }
.authorized-section { margin-top: 10rpx; }
.section-title { display: block; min-width: 0; color: var(--color-title, #222620); font-size: 27rpx; font-weight: 650; }
.pet-list { display: flex; flex-direction: column; gap: 16rpx; margin-top: 18rpx; }
.pet-button { justify-content: space-between; gap: 20rpx; width: 100%; margin: 0; border: 1rpx solid var(--color-line, #e4e7e1); background: var(--color-surface-soft, #f6f6f3); text-align: left; }
.pet-button.selected { border-color: var(--color-primary, #e7be44); background: var(--color-primary-soft, #fff4cc); }
.pet-name { flex: 1; min-width: 0; color: var(--color-title, #222620); font-size: 27rpx; overflow-wrap: anywhere; }
.pet-action { flex-shrink: 0; color: var(--color-primary-deep, #8a651d); font-size: 21rpx; }
.device-card { min-width: 0; }
.compact-metrics { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10rpx 20rpx; margin-top: 16rpx; color: var(--color-muted, #798278); font-size: 23rpx; line-height: 1.6; overflow-wrap: anywhere; }
.fold-button { display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; gap: 16rpx; width: 100%; min-height: 88rpx; margin: 10rpx 0 0; padding: 12rpx 0; border: 0; border-top: 1rpx solid var(--color-line, #e4e7e1); background: transparent; color: var(--color-muted, #798278); font-size: 22rpx; line-height: 1.5; }
.fold-button::after { border: 0; }
.fold-label { flex: 1; min-width: 0; text-align: left; }
.fold-indicator { flex-shrink: 0; color: var(--color-primary-deep, #8a651d); }
.connection-options { padding-top: 8rpx; }
.option-button { width: 100%; justify-content: flex-start; padding-left: 0; color: var(--color-muted, #798278); font-size: 22rpx; }
.device-name { flex: 1; min-width: 0; color: var(--color-title, #222620); font-size: 32rpx; font-weight: 750; overflow-wrap: anywhere; }
.device-badge { flex-shrink: 0; padding: 8rpx 14rpx; border-radius: 8rpx; color: var(--color-muted, #798278); background: var(--color-surface-soft, #f6f6f3); font-size: 21rpx; }
.metric-grid { display: flex; flex-wrap: wrap; box-sizing: border-box; min-width: 0; margin-top: 24rpx; border: 1rpx solid var(--color-line, #e4e7e1); border-radius: 12rpx; overflow: hidden; }
.metric { box-sizing: border-box; flex: 0 0 50%; width: 50%; min-width: 0; padding: 22rpx 16rpx; }
.metric + .metric { border-left: 1rpx solid var(--color-line, #e4e7e1); }
.metric.voice { flex: 0 0 100%; width: 100%; border-top: 1rpx solid var(--color-line, #e4e7e1); border-left: 0; }
.metric-label, .metric-note { display: block; color: var(--color-muted, #798278); font-size: 21rpx; line-height: 1.6; overflow-wrap: anywhere; }
.metric-value { display: block; margin: 12rpx 0; color: var(--color-title, #222620); font-size: 34rpx; font-weight: 750; overflow-wrap: anywhere; }
.voice-value { display: block; margin: 12rpx 0; color: var(--color-title, #222620); font-size: 27rpx; font-weight: 650; line-height: 1.6; overflow-wrap: anywhere; }
.details { margin-top: 28rpx; }
.fact-row { display: flex; justify-content: space-between; gap: 20rpx; padding: 18rpx 0; border-bottom: 1rpx solid var(--color-line, #e4e7e1); color: var(--color-muted, #798278); font-size: 23rpx; line-height: 1.6; }
.fact-label { flex: 0 0 38%; min-width: 0; }
.fact-value { flex: 1; min-width: 0; color: var(--color-title, #222620); text-align: right; overflow-wrap: anywhere; }
.voice-heading { margin-top: 28rpx; }
.sample-note { display: flex; flex-direction: column; gap: 8rpx; margin-top: 24rpx; color: var(--color-muted, #798278); font-size: 20rpx; line-height: 1.6; overflow-wrap: anywhere; }
.sample-time { font-family: monospace; }
.empty-copy { padding: 18rpx; border-radius: 10rpx; background: var(--color-surface-soft, #f6f6f3); }
@media (max-width: 360px) { .live-panel { padding: 20rpx; } .panel-title { font-size: 30rpx; } .text-button { padding-right: 8rpx; padding-left: 8rpx; font-size: 21rpx; } .fact-row { gap: 14rpx; font-size: 22rpx; } }
