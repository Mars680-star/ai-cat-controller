.pet-header { display: flex; align-items: center; gap: var(--space-6); }
.avatar { flex: 0 0 auto; width: 176rpx; height: 176rpx; border-radius: var(--radius-card); background: var(--color-primary-soft); object-fit: cover; }
.copy { flex: 1; min-width: 0; }
.name-row { display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-2); }
.name { max-width: 280rpx; overflow: hidden; color: var(--color-title); font-size: 40rpx; font-weight: 750; line-height: 1.25; text-overflow: ellipsis; white-space: nowrap; }
.personality { display: inline-flex; align-items: center; justify-content: flex-start; gap: var(--space-1); min-height: 56rpx; margin-top: var(--space-3); padding: 0 var(--space-3); border-radius: var(--radius-pill); color: var(--color-primary-deep); background: var(--color-primary-soft); font-size: 23rpx; text-align: left; }
.arrow { width: 28rpx; height: 28rpx; }
