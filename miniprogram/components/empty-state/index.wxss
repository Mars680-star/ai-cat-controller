.empty { display: flex; align-items: center; flex-direction: column; gap: var(--space-3); padding: calc(var(--space-8) + var(--space-6)) var(--space-6); border: 1rpx solid var(--color-line); border-radius: var(--radius-card); background: var(--color-surface); text-align: center; }
.empty-icon { width: 64rpx; height: 64rpx; opacity: .72; }
.title { color: var(--color-title); font-size: 29rpx; font-weight: 700; }
.desc { max-width: 520rpx; color: var(--color-muted); font-size: 24rpx; line-height: 1.55; }
.action { min-height: 84rpx; margin-top: var(--space-2); padding: var(--space-4) var(--space-6); border-radius: var(--radius-control); color: var(--color-title); background: var(--color-primary); box-shadow: var(--shadow-button); font-size: 26rpx; font-weight: 650; }
