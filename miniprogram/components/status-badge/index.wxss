.badge { display: inline-flex; align-items: center; gap: var(--space-1); min-height: 44rpx; padding: var(--space-1) var(--space-3); border-radius: var(--radius-pill); font-size: 20rpx; font-weight: 600; line-height: 1.3; }
.dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: currentColor; }
.badge-online, .badge-success, .badge-available, .badge-complete { color: var(--color-success); background: var(--color-success-soft); }
.badge-weak, .badge-info, .badge-running, .badge-waiting_assistant { color: var(--color-info); background: var(--color-info-soft); }
.badge-offline, .badge-danger, .badge-unavailable { color: var(--color-danger); background: var(--color-danger-soft); }
.badge-locked, .badge-neutral { color: var(--color-muted); background: var(--color-surface-soft); }
