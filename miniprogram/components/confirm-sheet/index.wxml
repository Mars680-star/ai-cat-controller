<view wx:if="{{visible}}" class="backdrop" bindtap="cancel" catchtouchmove="stop"><view class="sheet" catchtap="stop" role="dialog" aria-label="{{title}}"><view class="handle"></view><text class="title">{{title}}</text><text class="desc">{{description}}</text><view class="actions"><button class="sheet-button cancel" bindtap="cancel" disabled="{{loading}}">取消</button><button class="sheet-button confirm {{danger ? 'danger' : ''}}" bindtap="confirm" disabled="{{loading}}">{{loading ? '处理中…' : confirmText}}</button></view></view></view>
