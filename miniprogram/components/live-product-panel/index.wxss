.connection-panel { margin-bottom: 24rpx; padding: 22rpx 26rpx 12rpx; border: 1rpx solid var(--color-line); border-radius: 18rpx; background: var(--color-surface); }
.connection-heading { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.identity-copy { flex: 1; min-width: 0; }
.connection-title { display: block; color: var(--color-title); font-size: 28rpx; font-weight: 700; overflow-wrap: anywhere; }
.connection-status { display: block; margin-top: 8rpx; color: var(--color-muted); font-size: 22rpx; line-height: 1.5; }
.connection-status.online { color: var(--color-success, #2d7d5e); }
.connection-copy { display: block; margin-top: 10rpx; color: var(--color-muted); font-size: 22rpx; line-height: 1.65; }
.connection-error { margin-top: 20rpx; color: var(--color-danger); font-size: 25rpx; line-height: 1.6; overflow-wrap: anywhere; }
.panel-button { display: flex; align-items: center; justify-content: center; min-height: 88rpx; width: 100%; margin: 22rpx 0 0; padding: 16rpx; box-sizing: border-box; border: 0; border-radius: 12rpx; background: var(--color-primary-deep); color: #fff; font-size: 25rpx; line-height: 1.5; white-space: normal; }
.panel-button::after, .text-button::after, .pet-button::after { border: 0; }
.panel-button.secondary { color: var(--color-title); background: var(--color-surface-soft); }
.pet-list { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 18rpx; }
.pet-button { min-height: 80rpx; max-width: 100%; margin: 0; padding: 16rpx 24rpx; border: 1rpx solid var(--color-line); border-radius: 12rpx; background: var(--color-surface-soft); color: var(--color-title); font-size: 25rpx; line-height: 1.6; white-space: normal; overflow-wrap: anywhere; }
.pet-button.selected { border-color: var(--color-primary); background: var(--color-primary-soft); }
.connection-actions { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }
.text-button { min-height: 80rpx; margin: 0; padding: 16rpx 12rpx; background: transparent; color: var(--color-primary-deep); font-size: 24rpx; line-height: 1.7; }
.text-button.subtle { color: var(--color-muted); font-size: 22rpx; }
.refresh-button { flex: 0 0 auto; min-width: 88rpx; min-height: 88rpx; padding: 16rpx 8rpx; }
.fold-button { display: flex; align-items: center; justify-content: space-between; box-sizing: border-box; gap: 16rpx; width: 100%; min-height: 88rpx; margin: 10rpx 0 0; padding: 12rpx 0; border: 0; border-top: 1rpx solid var(--color-line); color: var(--color-muted); background: transparent; font-size: 22rpx; line-height: 1.5; }
.fold-button::after { border: 0; }
.fold-label { flex: 1; min-width: 0; text-align: left; }
.fold-indicator { flex-shrink: 0; color: var(--color-primary-deep); }
.connection-options { padding: 4rpx 0 8rpx; }
button[disabled] { opacity: .55; }
