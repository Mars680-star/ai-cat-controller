.card { display: flex; align-items: flex-start; flex-direction: column; box-sizing: border-box; gap: var(--space-3); width: 100%; max-width: 100%; min-width: 0; min-height: 338rpx; margin: 0; padding: var(--space-5); border: 1rpx solid var(--color-line); border-radius: var(--radius-card); text-align: left; line-height: 1.5; background: var(--color-surface); box-shadow: var(--shadow-card); }
.card::after { border: 0; }
.card.running { border-color: var(--color-info-border); background: var(--color-info-soft); }
.card.locked, .card.unavailable, .card.is-offline { color: var(--color-muted); background: var(--color-surface-soft); box-shadow: none; opacity: .72; }
.icon-shell { display: flex; align-items: center; justify-content: space-between; width: 100%; }
.action-icon { width: 52rpx; height: 52rpx; }
.lock-icon { width: 30rpx; height: 30rpx; opacity: .58; }
.name { display: -webkit-box; overflow: hidden; color: var(--color-title); font-size: 30rpx; font-weight: 700; line-height: 1.35; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.desc { display: -webkit-box; flex: 1; overflow: hidden; color: var(--color-muted); font-size: 22rpx; line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.locked .name, .unavailable .name, .is-offline .name { color: var(--color-muted); }
