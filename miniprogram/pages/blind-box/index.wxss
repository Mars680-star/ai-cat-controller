.blind-page { min-height: 100vh; padding: var(--space-6) var(--space-7) calc(var(--space-7) + env(safe-area-inset-bottom)); background: var(--color-bg); }
.loading { display: flex; align-items: center; justify-content: center; min-height: 70vh; color: var(--color-muted); }
.cat { width: 100%; height: 40vh; max-height: 590rpx; border-radius: var(--radius-card); background: var(--color-pet-surface); box-shadow: var(--shadow-card); }
.result { display: flex; align-items: center; flex-direction: column; gap: var(--space-3); padding-top: var(--space-6); text-align: center; }
.eyebrow { color: var(--color-muted); font-size: 23rpx; letter-spacing: 2rpx; }
.name { color: var(--color-primary-deep); font-size: 46rpx; font-weight: 750; line-height: 1.3; }
.description { color: var(--color-title); font-size: 27rpx; line-height: 1.6; }
.language { display: flex; flex-direction: column; gap: var(--space-1); width: 100%; padding: var(--space-5); border-radius: var(--radius-card); text-align: left; background: var(--color-primary-soft); }
.language-label { color: var(--color-primary-deep); font-size: 22rpx; font-weight: 650; }
.language-value { font-size: 25rpx; line-height: 1.5; }
.enter { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 92rpx; margin-top: var(--space-3); border-radius: var(--radius-control); color: var(--color-title); background: var(--color-primary); box-shadow: var(--shadow-button); font-size: 29rpx; font-weight: 700; }
.enter.is-disabled { color: var(--color-muted); background: var(--color-disabled); box-shadow: none; }
.note { color: var(--color-muted); font-size: 21rpx; }
