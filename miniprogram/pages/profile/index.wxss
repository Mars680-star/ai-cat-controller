.page-heading-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; margin-bottom: 20rpx; }
.page-title { font-size: 40rpx; line-height: 1.25; letter-spacing: 0; }
.eyebrow, .section-kicker { display: block; margin-bottom: 10rpx; color: #8b6728; font-size: 24rpx; font-weight: 600; }
.preview-badge { flex-shrink: 0; padding: 10rpx 14rpx; border-radius: 8rpx; color: #8b6728; background: #f4ecda; font-size: 24rpx; line-height: 1.4; }
.account-line { display: flex; flex-wrap: wrap; align-items: center; gap: 10rpx 20rpx; margin-bottom: 24rpx; color: #857d70; font-size: 24rpx; line-height: 1.55; }
.user-name { color: #373a32; font-weight: 600; }
.preview-note { display: flex; align-items: flex-start; gap: 14rpx; margin-bottom: 30rpx; color: #786b53; font-size: 24rpx; line-height: 1.65; }
.preview-mark { flex: 0 0 auto; margin-top: 3rpx; padding: 1rpx 7rpx; border: 1rpx solid #ddcfb0; border-radius: 5rpx; color: #967023; font-size: 20rpx; font-weight: 600; }
.settings-section { padding: 28rpx; border: 1rpx solid #e8e3d9; border-radius: 18rpx; background: #fffefa; }
.feedback-section { margin-top: 30rpx; }
.section-heading { margin-bottom: 24rpx; }
.section-title { font-size: 30rpx; }
.section-copy, .field-note { display: block; margin-top: 8rpx; color: #857d70; font-size: 24rpx; line-height: 1.6; }
.field { margin-top: 26rpx; gap: 12rpx; }
.field-label { font-size: 27rpx; }
.field-input { min-height: 88rpx; height: 88rpx; border-radius: 12rpx; border-color: #e5e0d6; font-size: 28rpx; background: #fff; }
.field-textarea { min-height: 250rpx; height: 250rpx; padding: 22rpx; border-color: #e5e0d6; border-radius: 12rpx; font-size: 27rpx; line-height: 1.7; background: #fff; }
.field-note { margin-top: 0; }
.field-hint { gap: 12rpx; color: #857d70; font-size: 24rpx; line-height: 1.5; }
.optional { margin-left: 12rpx; color: #918775; font-size: 24rpx; font-weight: 400; }
.picker-value { display: flex; align-items: center; justify-content: space-between; }
.picker-arrow { color: #8b6728; }
.range-field { padding: 30rpx 0 26rpx; border-bottom: 1rpx solid #eee9df; }
.range-heading { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; color: #373a32; font-size: 27rpx; }
.range-value { color: #8b6728; font-size: 25rpx; }
.range-field slider { margin: 22rpx 0 14rpx; }
.pending-note { display: block; margin-top: 26rpx; color: #967023; font-size: 24rpx; }
.btn { width: 100%; min-height: 88rpx; padding: 20rpx 24rpx; border-radius: 12rpx; font-size: 27rpx; letter-spacing: 0; box-shadow: none; }
.btn-primary { color: #fff; background: #967023; }
.btn-secondary { color: #806020; border-color: #e0d5bc; background: #fffaf0; }
.btn[disabled] { color: #aaa395; background: #efede6; }
.save-action { margin-top: 30rpx; }
.data-section-heading { margin: 44rpx 0 22rpx; }
.danger-zone { margin-top: 20rpx; padding: 28rpx; border: 1rpx solid #e8e1d6; border-radius: 16rpx; background: #fffefa; }
.danger-title, .danger-copy, .scope-note, .memory-note { display: block; }
.danger-title { color: #373a32; font-size: 29rpx; font-weight: 600; }
.danger-copy { margin-top: 12rpx; color: #7b7468; font-size: 24rpx; line-height: 1.75; }
.danger-zone .btn { margin-top: 24rpx; }
.btn-danger { color: #a65549; border-color: #e8cfc7; background: #fff6f2; }
.scope-note { margin-top: 14rpx; color: #928475; font-size: 24rpx; line-height: 1.6; }
.memory-note { margin-top: 14rpx; color: #8b6728; font-size: 24rpx; line-height: 1.6; }
.danger-zone.critical { border-color: #e7c9bf; background: #fff8f4; }
.reset-button { color: #fff; background: #a65e50; }
.logout-button { margin-top: 32rpx; border: 1rpx solid #e3dcd0; color: #5b594f; background: transparent; }
.logout-note { display: block; margin-top: 16rpx; color: #918775; font-size: 24rpx; text-align: center; line-height: 1.6; }
.preferences-status { margin-bottom: 30rpx; padding: 24rpx; border: 1rpx solid #e7d5a9; border-radius: 14rpx; background: #fff9e9; }
.real-reading { display: flex; flex-direction: column; gap: 8rpx; margin: 18rpx 0; color: #736c5e; font-size: 25rpx; line-height: 1.5; }
.request-error { display: block; margin-top: 20rpx; color: #a65549; font-size: 24rpx; line-height: 1.6; }
.receipt-note { margin: 22rpx 0; padding: 22rpx; border: 1rpx solid #e5dece; border-radius: 12rpx; color: #665a40; background: #faf7ef; font-size: 24rpx; line-height: 1.75; overflow-wrap: anywhere; }
.receipt-step { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10rpx 18rpx; margin-top: 12rpx; padding-top: 12rpx; border-top: 1rpx solid #e7e0d2; }
.refresh-link { margin: 20rpx 0 0; background: transparent; color: #8b6728; font-size: 25rpx; }
.refresh-link::after { border: 0; }
