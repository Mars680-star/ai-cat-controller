.page-heading { margin-bottom: 28rpx; }
.readonly-note { display: block; margin: 20rpx 0; padding: 22rpx; border: 1rpx solid var(--color-primary-border); border-radius: 16rpx; color: var(--color-muted); background: var(--color-primary-soft); font-size: 24rpx; line-height: 1.65; overflow-wrap: anywhere; }
.error-note { border-color: var(--color-danger-border); color: var(--color-danger); background: var(--color-danger-soft); }
.text-refresh { min-height: 88rpx; margin: 14rpx 0 0; padding: 18rpx; color: var(--color-primary-deep); background: var(--color-surface); font-size: 24rpx; line-height: 1.5; }
.more-records { width: 100%; min-height: 88rpx; margin-top: 24rpx; }
.real-control-status { margin: 20rpx 0 26rpx; padding: 22rpx; border: 1rpx solid var(--color-primary-border); border-radius: 16rpx; background: var(--color-primary-soft); }
.control-status-heading { display: flex; align-items: center; flex-wrap: wrap; justify-content: space-between; gap: 14rpx; }
.control-status-heading .text-refresh { margin: 0; }
.control-error { display: block; margin-top: 14rpx; color: var(--color-danger); font-size: 24rpx; line-height: 1.6; overflow-wrap: anywhere; }
.control-receipt { margin-top: 24rpx; padding: 24rpx; border: 1rpx solid var(--color-line); border-radius: 18rpx; background: var(--color-surface); }
.receipt-reference { display: block; margin-top: 12rpx; color: var(--color-muted); font-size: 22rpx; line-height: 1.6; overflow-wrap: anywhere; }
.composer-input[disabled], .voice-actions button[disabled] { opacity: .6; }
.eyebrow, .section-kicker { display: block; color: var(--color-primary-deep); font-size: 24rpx; font-weight: 600; }
.eyebrow { margin-bottom: 10rpx; }
.page-title { font-size: 40rpx; line-height: 1.35; word-break: break-word; }
.page-description { display: block; margin-top: 12rpx; color: var(--color-muted); font-size: 26rpx; line-height: 1.65; }
.voice-panel { padding: 28rpx; border: 1rpx solid var(--color-primary-border); border-radius: 24rpx; background: var(--color-surface); }
.voice-top { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12rpx; }
.preview-badge { padding: 8rpx 14rpx; border-radius: 10rpx; color: var(--color-primary-deep); background: var(--color-primary-soft); font-size: 24rpx; }
.voice-phase { display: block; margin: 24rpx 0 10rpx; color: var(--color-title); font-size: 34rpx; font-weight: 650; line-height: 1.4; }
.voice-hint { display: block; color: var(--color-muted); font-size: 26rpx; line-height: 1.65; }
.voice-timing { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20rpx; margin: 26rpx 0; padding: 22rpx 0; border-top: 1rpx solid var(--color-line); border-bottom: 1rpx solid var(--color-line); }
.timing-label { display: block; color: var(--color-muted); font-size: 24rpx; }
.timing-value { display: block; margin-top: 8rpx; color: var(--color-title); font-size: 32rpx; font-weight: 650; }
.timing-note { max-width: 100%; color: var(--color-muted); font-size: 24rpx; line-height: 1.6; }
.voice-actions { display: flex; flex-direction: column; gap: 16rpx; }
.voice-actions > button { width: 100%; min-height: 88rpx; border-radius: 18rpx; font-size: 26rpx; }
.wake-hint { display: flex; flex-direction: column; gap: 8rpx; margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid var(--color-line); color: var(--color-muted); font-size: 24rpx; line-height: 1.6; }
.wake-phrase { color: var(--color-primary-deep); font-size: 28rpx; font-weight: 600; }
.composer-card { margin-top: 28rpx; padding: 28rpx; border: 1rpx solid var(--color-line); border-radius: 24rpx; background: var(--color-surface); }
.composer-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12rpx; }
.section-title { font-size: 30rpx; }
.composer-heading > text:last-child { color: var(--color-muted); font-size: 24rpx; }
.composer-input { width: 100%; height: 224rpx; min-height: 224rpx; max-height: 320rpx; overflow-y: auto; margin: 24rpx 0 12rpx; padding: 22rpx; border: 1rpx solid var(--color-line); border-radius: 16rpx; color: var(--color-title); background: var(--color-surface-soft); font-size: 28rpx; line-height: 1.6; }
.draft-hint { display: block; margin-bottom: 24rpx; color: var(--color-muted); font-size: 24rpx; line-height: 1.6; }
.composer-bottom { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16rpx; }
.composer-bottom > text { color: var(--color-muted); font-size: 24rpx; }
.send-action { display: flex; align-items: center; justify-content: center; min-width: 180rpx; min-height: 88rpx; padding: 20rpx 24rpx; border-radius: 18rpx; color: var(--color-title); background: var(--color-primary); font-size: 26rpx; font-weight: 600; }
.send-action[disabled] { color: var(--color-muted); background: var(--color-surface-soft); }
.pending { display: flex; align-items: flex-start; flex-wrap: wrap; gap: 16rpx; margin-top: 24rpx; padding: 22rpx; border-radius: 16rpx; background: var(--color-primary-soft); }
.pending.failed { background: var(--color-danger-soft); }
.pending-copy { flex: 1; min-width: 0; }
.pending-content { display: block; color: var(--color-title); font-size: 26rpx; line-height: 1.6; word-break: break-word; }
.pending-status { display: block; margin-top: 8rpx; color: var(--color-muted); font-size: 24rpx; }
.pending-retry { min-height: 88rpx; padding: 20rpx 16rpx; border: 1rpx solid var(--color-danger-border); border-radius: 14rpx; color: var(--color-danger); background: var(--color-surface); font-size: 26rpx; }
.conversation-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16rpx; margin: 40rpx 0 20rpx; }
.section-copy, .sync-text { display: block; margin-top: 8rpx; color: var(--color-muted); font-size: 24rpx; line-height: 1.5; }
.conversation-list { overflow: hidden; border: 1rpx solid var(--color-line); border-radius: 24rpx; background: var(--color-surface); }
.conversation-item { display: flex; flex-direction: column; gap: 14rpx; width: 100%; min-width: 0; padding: 28rpx; text-align: left; }
.conversation-item + .conversation-item { border-top: 1rpx solid var(--color-line); }
.conversation-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.conversation-title { display: -webkit-box; flex: 1; overflow: hidden; min-width: 0; color: var(--color-title); font-size: 28rpx; font-weight: 600; line-height: 1.6; word-break: break-word; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.detail-arrow { flex-shrink: 0; color: var(--color-muted); font-size: 36rpx; }
.assistant-preview { display: -webkit-box; overflow: hidden; color: var(--color-text); font-size: 26rpx; line-height: 1.65; word-break: break-word; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.conversation-time { color: var(--color-muted); font-size: 24rpx; }
.conversation-meta { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12rpx; color: var(--color-muted); font-size: 24rpx; }
.conversation-status { padding: 8rpx 12rpx; border-radius: 10rpx; color: var(--color-primary-deep); background: var(--color-primary-soft); }
.conversation-status.waiting_assistant { color: var(--color-info); background: var(--color-info-soft); }
@media (max-width: 340px) { .send-action { width: 100%; } }
