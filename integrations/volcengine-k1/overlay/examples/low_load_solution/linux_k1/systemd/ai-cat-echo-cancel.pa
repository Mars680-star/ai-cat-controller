# Route default playback and capture through one paired WebRTC AEC filter.
# The physical K1 ES8326 codec is exposed by PulseAudio with these stable names.
load-module module-echo-cancel source_master=alsa_input.platform-snd-card_1.stereo-fallback sink_master=alsa_output.platform-snd-card_1.stereo-fallback source_name=ai_cat_echo_cancel_source sink_name=ai_cat_echo_cancel_sink aec_method=webrtc use_master_format=1 source_properties=device.description=AI-Cat-AEC-Source sink_properties=device.description=AI-Cat-AEC-Sink
set-default-source ai_cat_echo_cancel_source
set-default-sink ai_cat_echo_cancel_sink
set-source-volume ai_cat_echo_cancel_source 65536
