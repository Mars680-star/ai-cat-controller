# Runs both low-frequency local autonomy and one-shot answer micro-motions.
# Tune behavior with environment values; keep motor commands behind FastAPI's
# motion lock and the native fixed-preset allowlist.
[Unit]
Description=AI Cat Safe Autonomous Head Motion and Speech
After=ai-cat-controller.service volc-pulseaudio.service
Requires=ai-cat-controller.service volc-pulseaudio.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=root
Group=pulse-access
SupplementaryGroups=root
WorkingDirectory=/opt/ai-cat-controller
EnvironmentFile=/etc/ai-cat-controller.env
Environment=PYTHONUNBUFFERED=1
Environment=PULSE_SERVER=unix:/var/run/pulse/native
Environment=AI_CAT_AUTONOMY_MIN_INTERVAL_SECONDS=180
Environment=AI_CAT_AUTONOMY_MAX_INTERVAL_SECONDS=180
Environment=AI_CAT_AUTONOMY_PHRASE_PROBABILITY=1.0
Environment=AI_CAT_AUTONOMY_CLOUD_SPEECH_ENABLED=false
Environment=AI_CAT_AUTONOMY_LOCAL_SPEECH_ENABLED=true
Environment=AI_CAT_AUTONOMY_LOCAL_SPEECH_ASSET_ROOT=/opt/ai-cat-controller/assets/local-speech
Environment=AI_CAT_AUTONOMY_LOCAL_SPEECH_MOTION_SETTLE_SECONDS=2.2
Environment=AI_CAT_CONVERSATION_MOTION_ENABLED=true
Environment=AI_CAT_CONVERSATION_MOTION_PROBABILITY=1.0
Environment=AI_CAT_CONVERSATION_MOTION_DELAY_SECONDS=1.0
Environment=AI_CAT_CONVERSATION_POLL_INTERVAL_SECONDS=0.5
Environment=AI_CAT_CONVERSATION_HEAD_MIN_INTERVAL_SECONDS=7.0
Environment=AI_CAT_CONVERSATION_HEAD_MAX_INTERVAL_SECONDS=10.0
Environment=AI_CAT_CONVERSATION_TAIL_ENABLED=true
Environment=AI_CAT_CONVERSATION_TAIL_DELAY_SECONDS=2.0
Environment=AI_CAT_CONVERSATION_TAIL_MIN_INTERVAL_SECONDS=3.0
Environment=AI_CAT_CONVERSATION_TAIL_MAX_INTERVAL_SECONDS=4.5
ExecStartPre=/usr/bin/rm -f /run/ai-cat/local-speech-active
ExecStart=/opt/ai-cat-controller/.venv/bin/python -m ai_cat_controller.autonomy
ExecStopPost=/usr/bin/rm -f /run/ai-cat/local-speech-active
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
