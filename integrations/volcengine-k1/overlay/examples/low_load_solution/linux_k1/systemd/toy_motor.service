[Unit]
Description=AI Cat Safe Autonomous Head Motion and Speech
After=ai-cat-controller.service volc-conv-ai.service
Requires=ai-cat-controller.service
Wants=volc-conv-ai.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/ai-cat-controller
EnvironmentFile=/etc/ai-cat-controller.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/ai-cat-controller/.venv/bin/python -m ai_cat_controller.autonomy
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
