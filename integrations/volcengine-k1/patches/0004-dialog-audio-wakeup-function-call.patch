+static cJSON* __first_array_item(cJSON* object, const char* name) {
+    cJSON* array = cJSON_GetObjectItemCaseSensitive(object, name);
+
+    if (!cJSON_IsArray(array) || cJSON_GetArraySize(array) == 0) {
+        return NULL;
+    }
+    return cJSON_GetArrayItem(array, 0);
+}
