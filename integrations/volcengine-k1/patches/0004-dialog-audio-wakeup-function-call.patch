+    if (code == 1 || code == 2) {
+        return "少云";
+    }
+    if (code == 3) {
+        return "阴";
+    }
+    if (code == 45 || code == 48) {
+        return "有雾";
+    }
+    if (code >= 51 && code <= 57) {
+        return "毛毛雨";
+    }
+    if (code >= 61 && code <= 67) {
+        return "有雨";
+    }
+    if (code >= 71 && code <= 77) {
+        return "有雪";
+    }
+    if (code >= 80 && code <= 82) {
+        return "有阵雨";
+    }
+    if (code >= 85 && code <= 86) {
+        return "有阵雪";
+    }
+    if (code >= 95 && code <= 99) {
+        return "有雷暴";
+    }
+    return "天气状况未知";
+}
